{
  "name": "codex-zcode-relay",
  "version": "0.3.0",
  "private": true,
  "description": "GLM external task execution through OpenCode, Codex CLI and the event-driven ZCode desktop MCP relay",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "scripts": {
    "start": "node relay-mcp.cjs controller",
    "worker": "node relay-mcp.cjs worker",
    "setup": "node setup.cjs",
    "test": "node --test test/*.test.cjs",
    "verify": "node verify-relay.cjs",
    "test:opencode": "python -m unittest discover -s integrations/opencode/test -p \"test_*.py\"",
    "test:legacy": "node --test experiments/zcode-cli/test/*.test.cjs"
  }
}
