{
  "name": "codex-zcode-relay",
  "version": "0.2.0",
  "private": true,
  "description": "Local event-driven MCP relay between Codex and ZCode desktop native agents",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "scripts": {
    "start": "node relay-mcp.cjs controller",
    "worker": "node relay-mcp.cjs worker",
    "setup": "node setup.cjs",
    "test": "node --test test/*.test.cjs",
    "verify": "node verify-relay.cjs"
  }
}
